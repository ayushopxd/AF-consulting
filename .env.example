RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
BOOKINGS_PASSWORD=choose_a_long_private_password

# Firebase Web configuration — public client configuration, embedded in the browser bundle at build time.
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
FIREBASE_WEB_AUTH_DOMAIN=ananya-s-fusion.firebaseapp.com
FIREBASE_WEB_PROJECT_ID=ananya-s-fusion
FIREBASE_WEB_STORAGE_BUCKET=your_firebase_storage_bucket
FIREBASE_WEB_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
FIREBASE_WEB_APP_ID=your_firebase_web_app_id

# Firebase Admin credentials — server-only secrets for Netlify Functions. Never expose or commit these.
FIREBASE_ADMIN_SERVICE_ACCOUNT_BASE64=base64_encoded_service_account_json
