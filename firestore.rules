rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // This custom claim is assigned only by trusted Firebase Admin code.
    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if isAdmin();
      allow read: if isAdmin();

      // User profiles, roles, and timestamps are created/updated by trusted
      // server code. This prevents client-side role escalation.
      allow create, update, delete: if false;
    }

    match /orders/{orderId} {
      allow get: if signedIn() && resource.data.userId == request.auth.uid;
      allow list: if signedIn() && resource.data.userId == request.auth.uid;
      allow read: if isAdmin();

      // Razorpay verification, ownership, public IDs, payment status, and
      // lifecycle changes are server-controlled. The Admin SDK bypasses rules
      // only inside authorized Netlify Functions.
      allow create, update, delete: if false;
    }

    match /bookings/{bookingId} {
      // Customers may create only their own unpaid, pending booking using the
      // current browser booking shape. Payment and lifecycle changes remain
      // trusted-server operations.
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "pending_payment"
        && request.resource.data.paymentStatus == "unpaid"
        && request.resource.data.keys().hasOnly([
          "userId", "userName", "userEmail", "userPhone", "service", "plan",
          "amount", "status", "paymentStatus", "createdAt", "updatedAt"
        ]);

      allow get, list: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);

      allow update, delete: if false;
    }
  }
}
